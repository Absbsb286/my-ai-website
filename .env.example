# EMQX Serverless MQTT WebSocket URL (with embedded credentials)
# Format: wss://username:password@hostname:port/path
# Get from: https://cloud.emqx.com/console/deployments
EMQX_WS_URL="wss://your-username:your-password@your-hostname:8084/mqtt"

# TURN server credentials
# Get from: https://www.twilio.com/console/voice/runtime/configure (for Twilio)
# Or use evan-brass.net public credentials
TURN_USERNAME="your-turn-username"
TURN_CREDENTIAL="your-turn-credential"